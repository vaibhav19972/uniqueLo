{
  "name": "uniquelo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "seed:gen": "node ../backend/scripts/gen-seed.mjs",
    "seed:check": "node ../backend/scripts/gen-seed.mjs --check",
    "verify": "npm run typecheck && npm run lint && npm test && npm run seed:check && npm run contract:check && npm run schema:check && npm run publish:payload && npm run build",
    "preview": "vite preview",
    "contract:check": "node ../backend/scripts/check-contract.mjs",
    "publish:payload": "node ../backend/scripts/render-publish-payload.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "schema:check": "node ../backend/scripts/check-schema-completeness.mjs"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@supabase/supabase-js": "^2.117.2",
    "@tanstack/react-query": "^5.104.1",
    "@vercel/analytics": "^2.0.1",
    "clsx": "^2.1.1",
    "gsap": "^3.12.7",
    "lenis": "^1.3.1",
    "motion": "^12.7.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.5.0",
    "tailwind-merge": "^3.2.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.4",
    "@types/node": "^24.13.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.1.4",
    "typescript": "^5.7.3",
    "vite": "^6.3.1",
    "vitest": "^5.0.5"
  }
}
