# UniqueLo Storefront Environment Configuration
# Copy to .env for local testing or set these variables in Vercel / Production Server.

# ── Supabase Integration (Vercel & Supabase Architecture) ──
# Connect your Supabase project (Project Settings > API)
# When set, the catalog, reviews, newsletter & orders connect to Supabase.
# When left unset or blank, UniqueLo automatically and gracefully falls back
# to the bundled high-fidelity seed catalog (src/data/*.json).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ── Optional Legacy / Strapi REST Seam ──
# VITE_API_URL=http://localhost:1337